---
import type { ImageMetadata } from 'astro';

export function getImageUrl(path: string) {
  const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/content/post-cover/**/*.jpg');
  const imageImport = images[`/src/assets/images/content/post-cover/${path}`];

  return imageImport ? imageImport() : null;
}
