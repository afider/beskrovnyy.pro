---
import { getImage } from 'astro:assets';
import type { ImageMetadata, ImageOutputFormat } from 'astro';

const {img, imgDark, imgAlt, classNames, imgFormat} = Astro.props;

// Исходники рассчитаны на 2x; варианты 1x уменьшаются вдвое.
// Поддерживаются статические импорты и Promise модулей из import.meta.glob.
const importedImage = await img;
const importedDarkImage = await imgDark;
const image = importedImage?.default ?? importedImage;
const darkImage = importedDarkImage?.default ?? importedDarkImage;
const format: ImageOutputFormat = imgFormat || 'jpg';

async function createSources(image: ImageMetadata) {
  const formats: ImageOutputFormat[] = ['avif', 'webp', format];

  return Promise.all(formats.map(async (outputFormat) => {
    const [small, large] = await Promise.all([
      getImage({
        src: image,
        format: outputFormat,
        width: Math.max(1, Math.round(image.width / 2)),
        height: Math.max(1, Math.round(image.height / 2)),
      }),
      getImage({ src: image, format: outputFormat }),
    ]);

    return {
      type: outputFormat === 'jpg' ? 'image/jpeg' : `image/${outputFormat}`,
      srcset: `${small.src} 1x, ${large.src} 2x`,
      small,
    };
  }));
}

const sources = image ? await createSources(image) : [];
const darkSources = darkImage ? await createSources(darkImage) : [];
const fallback = sources[2];
---
{darkSources.map((source) => (
  <source srcset={source.srcset} type={source.type} media="(prefers-color-scheme: dark)" data-dark />
))}
{sources.map((source) => (
  <source
    srcset={source.srcset}
    type={source.type}
    media={darkImage ? '(prefers-color-scheme: light)' : undefined}
    data-light={darkImage ? '' : undefined}
  />
))}
{fallback ? (
  <img src={fallback.small.src} srcset={fallback.srcset} {...fallback.small.attributes} alt={imgAlt} class={classNames} />
) : (
  <div class="warning">Не указан объект с изображением</div>
)}
