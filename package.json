{
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "lint": "stylelint \"src/**/*.scss\" --max-warnings 0",
    "check": "astro check --minimumFailingSeverity warning",
    "test": "node --test tests/*.test.mjs",
    "test:build": "node --test tests/build/*.test.mjs",
    "build": "astro build && pagefind --site dist --output-subdir pagefind",
    "preview": "astro preview",
    "verify": "npm run lint && npm run check && npm test && npm run build && npm run test:build"
  },
  "dependencies": {
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/prism": "^4.1.2",
    "astro-icon": "^1.2.0",
    "autoprefixer": "^10.4.15",
    "pagefind": "^1.5.2",
    "parse5": "^8.1.1",
    "sass": "^1.66.1",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3"
  }
}
